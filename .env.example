# ============================================================
# Portfolio Project – API Keys Configuration Template
# ============================================================
# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to version control.
#
# NOTE: All apps in this portfolio work out-of-the-box
# without keys using free, keyless fallback APIs.
# API keys unlock the full live data experience.
# ============================================================

# ----------------------------------------------------------
# OpenWeatherMap API Key
# Used by: Task III – API Studio > Weather Station tab
# Required for: Live weather data, real-time 5-day forecasts
# Fallback: Open-Meteo (free, keyless) activates automatically
#
# How to obtain:
#   1. Visit https://openweathermap.org/api
#   2. Sign up for a free account
#   3. Navigate to "API Keys" in your profile dashboard
#   4. Copy the default key or generate a new one
#   5. Free tier: 1,000 calls/day, 60 calls/minute
# ----------------------------------------------------------
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# ----------------------------------------------------------
# OMDB API Key (Open Movie Database)
# Used by: Task III – API Studio > Movie Searcher tab
# Required for: Live movie search, posters, ratings, plot data
# Fallback: Built-in local movie catalog activates automatically
#
# How to obtain:
#   1. Visit https://www.omdbapi.com/apikey.aspx
#   2. Select the "FREE" tier (1,000 daily requests)
#   3. Enter your email address and submit
#   4. Check your email for the activation link
#   5. Activate and copy your API key from the email
# ----------------------------------------------------------
OMDB_API_KEY=your_omdb_key_here

# ----------------------------------------------------------
# The following APIs are FREE and require NO key.
# They are used automatically by the apps below.
# ----------------------------------------------------------

# Open-Meteo Geocoding & Weather API (keyless)
# Docs: https://open-meteo.com/
# Used as: Weather fallback in API Studio

# Random User Generator API (keyless)
# Docs: https://randomuser.me/
# Used in: API Studio > People & Quotes tab

# DummyJSON Quotes API (keyless)
# Docs: https://dummyjson.com/docs/quotes
# Used in: API Studio > People & Quotes tab
